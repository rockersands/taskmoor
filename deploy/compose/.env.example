# Copy to .env. The Builder (M1) writes this file for you; until then fill it by hand.

# Bundled Postgres (docker-compose.yml): the database password. Any long random string.
POSTGRES_PASSWORD=change-me

# External Postgres (docker-compose.external.yml) only:
# DATABASE_URL=postgres://tracksmith:pass@db.example.com:5432/tracksmith

# Optional
# PUBLIC_URL=https://tracker.example.com   (the setup link and secure cookies follow it)
# TRACKSMITH_SETUP_TOKEN=                  (installers may fix the one-time setup token)
# TRACKSMITH_IMAGE=ghcr.io/rockersands/tracksmith:1.0.0
# TRACKSMITH_PORT=8080
# TRACKSMITH_ROLE=all
# LOG_LEVEL=info
# Monitoring (deploy/README.md): Prometheus scrapes tracksmith:9464 on the Compose network.
# METRICS_PORT=9464
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
