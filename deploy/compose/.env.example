# Copy to .env. The Builder (M1) writes this file for you; until then fill it by hand.

# Bundled Postgres (docker-compose.yml): the database password. Any long random string.
POSTGRES_PASSWORD=change-me

# External Postgres (docker-compose.external.yml) only:
# DATABASE_URL=postgres://taskmoor:pass@db.example.com:5432/taskmoor

# Optional
# PUBLIC_URL=https://tracker.example.com   (the setup link and secure cookies follow it)
# TASKMOOR_SETUP_TOKEN=                  (installers may fix the one-time setup token)
# TASKMOOR_IMAGE=ghcr.io/rockersands/taskmoor:1.0.0
# TASKMOOR_PORT=8080
# TASKMOOR_ROLE=all
# Clean URLs (/boards/7) by default; hash routing (/#/boards/7) where a proxy cannot pass deep links.
# TASKMOOR_WEB_ROUTING=path
# A web app served on another origin (a frontend kit on a static host): its origin, and where
# sign-in from another site returns (defaults to that origin's root).
# TASKMOOR_ALLOWED_ORIGINS=https://tracker.example.org
# TASKMOOR_OAUTH_REDIRECT_URIS=https://tracker.example.org/
# Behind a reverse proxy (Caddy, nginx, a load balancer), name it so sign-in limits see the real
# client address: TASKMOOR_TRUSTED_PROXIES=uniquelocal (private networks) or its address.
# TASKMOOR_TRUSTED_PROXIES=
# The password pepper lives in the data volume (/data/secrets/password-peppers) and travels in
# backups. To manage it yourself instead, set a random value of 32 characters or more:
# TASKMOOR_PASSWORD_PEPPER=
# The new-version notice for administrators looks at the project's public releases once a day.
# off stops it for good (the air-gap bundle's installer sets this):
# TASKMOOR_UPDATE_CHECK=off
# LOG_LEVEL=info
# Monitoring (deploy/README.md): Prometheus scrapes taskmoor:9464 on the Compose network.
# METRICS_PORT=9464
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Outgoing mail. Or fill in the setup form's mail fields and set only TASKMOOR_SMTP_PASSWORD
# (when the form names a user).
# TASKMOOR_SMTP_URL=smtp://mail.example.com:587
# TASKMOOR_SMTP_USER=taskmoor@example.com
# TASKMOOR_SMTP_PASSWORD=
# TASKMOOR_SMTP_FROM=Taskmoor <taskmoor@example.com>
# Attachments in an S3-compatible bucket instead of the data volume:
# TASKMOOR_S3_BUCKET=taskmoor-files
# TASKMOOR_S3_REGION=us-east-1
# TASKMOOR_S3_ENDPOINT=https://s3.example.com
# TASKMOOR_S3_ACCESS_KEY_ID=
# TASKMOOR_S3_SECRET_ACCESS_KEY=
# Backups somewhere other than the data volume (mount it with an override file), or off:
# TASKMOOR_BACKUP_DIR=/backups
