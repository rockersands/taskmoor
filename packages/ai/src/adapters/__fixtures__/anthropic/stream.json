{
  "description": "Streamed summary: text deltas arrive as server-sent events after a thinking block.",
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages?beta=true",
        "headers": {
          "x-api-key": "test-key-placeholder",
          "anthropic-version": "2023-06-01",
          "anthropic-beta": "server-side-fallback-2026-07-01",
          "authorization": null
        },
        "body": {
          "model": "claude-opus-5-5",
          "max_tokens": 16000,
          "system": [
            {
              "type": "text",
              "text": "You summarise work tickets for a project team. Keep to the facts in the ticket: purpose, status, who is working on it and what happens next.",
              "cache_control": {
                "type": "ephemeral"
              }
            },
            {
              "type": "text",
              "text": "Track WEB is the public website. Ticket keys look like WEB-123.",
              "cache_control": {
                "type": "ephemeral"
              }
            }
          ],
          "messages": [
            {
              "role": "user",
              "content": "Summarise WEB-42. Description: sign-in fails after a password reset. Comments: Sam is investigating; the fix belongs in the session service."
            }
          ],
          "thinking": {
            "type": "adaptive"
          },
          "output_config": {
            "effort": "low"
          },
          "fallbacks": "default",
          "stream": true
        }
      },
      "response": {
        "sse": [
          {
            "event": "message_start",
            "data": {
              "type": "message_start",
              "message": {
                "id": "msg_fixture_stream",
                "type": "message",
                "role": "assistant",
                "model": "claude-opus-5-5",
                "content": [],
                "stop_reason": null,
                "stop_sequence": null,
                "usage": {
                  "input_tokens": 110,
                  "output_tokens": 1,
                  "cache_read_input_tokens": 0,
                  "cache_creation_input_tokens": 0
                }
              }
            }
          },
          {
            "event": "content_block_start",
            "data": {
              "type": "content_block_start",
              "index": 0,
              "content_block": {
                "type": "thinking",
                "thinking": "",
                "signature": ""
              }
            }
          },
          {
            "event": "content_block_delta",
            "data": {
              "type": "content_block_delta",
              "index": 0,
              "delta": {
                "type": "signature_delta",
                "signature": "signature-placeholder"
              }
            }
          },
          {
            "event": "content_block_stop",
            "data": {
              "type": "content_block_stop",
              "index": 0
            }
          },
          {
            "event": "content_block_start",
            "data": {
              "type": "content_block_start",
              "index": 1,
              "content_block": {
                "type": "text",
                "text": ""
              }
            }
          },
          {
            "event": "ping",
            "data": {
              "type": "ping"
            }
          },
          {
            "event": "content_block_delta",
            "data": {
              "type": "content_block_delta",
              "index": 1,
              "delta": {
                "type": "text_delta",
                "text": "WEB-42: sign-in fails after a password reset. "
              }
            }
          },
          {
            "event": "content_block_delta",
            "data": {
              "type": "content_block_delta",
              "index": 1,
              "delta": {
                "type": "text_delta",
                "text": "Sam is investigating; the next step is a fix in the session service."
              }
