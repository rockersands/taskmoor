{
  "name": "taskmoor",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hostable work tracking with every premium feature included.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "verify": "node tools/verify/verify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "pnpm --filter @taskmoor/web e2e",
    "dev:web": "pnpm --filter @taskmoor/web dev",
    "dev:server": "pnpm --filter @taskmoor/server dev",
    "next-task": "tsx packages/devtools/src/cli/next-task.ts",
    "trace": "tsx packages/devtools/src/cli/trace.ts",
    "i18n:check": "tsx packages/devtools/src/cli/i18n-check.ts",
    "builder": "tsx packages/devtools/src/cli/builder.ts",
    "dco": "tsx packages/devtools/src/cli/dco.ts",
    "secrets": "gitleaks git --config .gitleaks.toml --log-opts=--all --redact --no-banner .",
    "gen": "tsx packages/testkit/src/cli/gen.ts",
    "gen:dc-backup": "tsx apps/server/src/import/dc-backup/cli.ts",
    "spike": "tsx packages/spikes/src/cli/spike.ts",
    "bench:check": "tsx packages/devtools/src/cli/bench-check.ts",
    "demo": "tsx apps/server/src/demo/cli.ts",
    "bench:search": "tsx apps/server/src/search/bench/cli.ts",
    "load": "tsx apps/server/src/load/cli.ts",
    "status-report": "tsx packages/devtools/src/cli/status-report.ts",
    "gate": "tsx packages/devtools/src/cli/gate.ts",
    "conformance": "tsx packages/devtools/src/cli/conformance.ts",
    "eval": "tsx apps/server/src/ai/evals/cli.ts",
    "fuzz": "tsx packages/devtools/src/cli/fuzz.ts",
    "build": "pnpm --filter @taskmoor/web build && pnpm --filter @taskmoor/web build:builder && node tools/build/server.mjs",
    "build:server": "node tools/build/server.mjs",
    "docs": "tsx packages/devtools/src/cli/docs.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64",
      "embedded-postgres",
      "esbuild"
    ],
    "overrides": {
      "axios": "1.20.0",
      "follow-redirects": "1.16.2",
      "fast-uri@^3": "3.1.9",
      "fast-uri@^4": "4.2.3",
      "nodemailer": "10.1.4"
    }
  }
}
