{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild",
    "rootDir": ".",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "build",
    "e2e",
    "playwright.config.ts",
    ".storybook",
    "vitest.stories.config.ts",
    "vitest.stories-dark.config.ts",
    "vitest.stories-touch.config.ts",
    "vitest.stories-dark-touch.config.ts",
    "vitest.stories.config.test.ts",
    "vitest.build.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/webconfig"
    },
    {
      "path": "../../packages/devtools"
    },
    {
      "path": "../../packages/builder-core"
    }
  ]
}
