{
  "format": "taskmoor-workflow",
  "version": 1,
  "workflow": {
    "name": "Default workflow",
    "description": "New, Active, In Review, Closed"
  },
  "statuses": [
    {
      "id": 1,
      "name": "New",
      "stage": "new",
      "description": ""
    },
    {
      "id": 2,
      "name": "Active",
      "stage": "active",
      "description": ""
    },
    {
      "id": 3,
      "name": "In Review",
      "stage": "active",
      "description": ""
    },
    {
      "id": 4,
      "name": "Closed",
      "stage": "closed",
      "description": ""
    }
  ],
  "definition": {
    "initialStatusId": 1,
    "statuses": [
      {
        "statusId": 1
      },
      {
        "statusId": 2
      },
      {
        "statusId": 3
      },
      {
        "statusId": 4
      }
    ],
    "transitions": [
      {
        "id": 1,
        "name": "Start",
        "from": [
          1
        ],
        "to": 2
      },
      {
        "id": 2,
        "name": "Send to review",
        "from": [
          2
        ],
        "to": 3
      },
      {
        "id": 3,
        "name": "Back to active",
        "from": [
          3
        ],
        "to": 2
      },
      {
        "id": 4,
        "name": "Close",
        "from": "any",
        "to": 4,
        "layout": [
          "close-reason"
        ],
        "checks": [
          {
            "type": "field-required",
            "field": "close-reason"
          }
        ]
      },
      {
        "id": 5,
        "name": "Reopen",
        "from": [
          4
        ],
        "to": 1,
        "effects": [
          {
            "type": "clear-field",
            "field": "close-reason"
          }
        ]
      }
    ]
  }
}
