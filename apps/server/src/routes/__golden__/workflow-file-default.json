{
  "format": "taskmoor-workflow",
  "version": 1,
  "workflow": {
    "name": "Default workflow",
    "description": "New, Active, In Review, Closed"
  },
  "statuses": [
    {
      "id": 1,
      "name": "New",
      "stage": "new",
      "description": ""
    },
    {
      "id": 2,
      "name": "Active",
      "stage": "active",
      "description": ""
    },
    {
      "id": 3,
      "name": "In Review",
      "stage": "active",
      "description": ""
    },
    {
      "id": 4,
      "name": "Closed",
      "stage": "closed",
      "description": ""
    }
  ],
  "closeReasons": [
    {
      "id": 1,
      "name": "Completed"
    }
  ],
  "definition": {
    "initialStatusId": 1,
    "statuses": [
      {
        "statusId": 1
      },
      {
        "statusId": 2
      },
      {
        "statusId": 3
      },
      {
        "statusId": 4
      }
    ],
    "transitions": [
      {
        "id": 5,
        "name": "New",
        "from": "any",
        "to": 1,
        "effects": [
          {
            "type": "clear-field",
            "field": "close-reason"
          }
        ]
      },
      {
        "id": 1,
        "name": "Active",
        "from": "any",
        "to": 2,
        "effects": [
          {
            "type": "clear-field",
            "field": "close-reason"
          }
        ]
      },
      {
        "id": 2,
        "name": "In Review",
        "from": "any",
        "to": 3,
        "effects": [
          {
            "type": "clear-field",
            "field": "close-reason"
          }
        ]
      },
      {
        "id": 4,
        "name": "Closed",
        "from": "any",
        "to": 4,
        "effects": [
          {
            "type": "update-system-field",
            "field": "close-reason",
            "value": "1"
          }
        ]
      }
    ]
  }
}
