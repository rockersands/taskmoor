{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fidelity": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "user",
              "group",
              "team",
              "role",
              "status",
              "priority",
              "close_reason",
              "ticket_type",
              "link_type",
              "track",
              "release",
              "area",
              "field",
              "field_context",
              "field_option",
              "field_rule_set",
              "layout_set",
              "workflow",
              "workflow_map",
              "ticket",
              "comment",
              "link",
              "time_entry",
              "attachment",
              "history"
            ],
            "type": "string"
          },
          "outcomes": {
            "additionalProperties": false,
            "properties": {
              "created": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "failed": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "linked": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "skipped": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "unchanged": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "updated": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "created",
              "updated",
              "unchanged",
              "linked",
              "failed",
              "skipped"
            ],
            "type": "object"
          },
          "source": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "target": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "source",
          "outcomes",
          "target",
          "fidelity"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "failures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "sourceId",
          "error"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "failuresTruncated": {
      "type": "boolean"
    },
    "mapping": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "user",
              "group",
              "team",
              "role",
              "status",
              "priority",
              "close_reason",
              "ticket_type",
              "link_type",
              "track",
              "release",
              "area",
              "field",
              "field_context",
              "field_option",
              "field_rule_set",
              "layout_set",
              "workflow",
              "workflow_map",
              "ticket",
              "comment",
              "link",
              "time_entry",
              "attachment",
              "history"
            ],
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "created",
              "updated",
              "unchanged",
              "linked",
              "failed",
              "skipped"
            ],
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceId": {
            "type": "string"
          },
          "targetId": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          }
        },
        "required": [
          "kind",
          "sourceId",
          "label",
          "outcome",
          "targetId",
          "reason",
          "warnings"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "mappingTruncated": {
      "type": "boolean"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "batches": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "dryRun": {
          "type": "boolean"
        },
        "finishedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "importSource": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sourceSystem": {
          "type": "string"
        },
        "startedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "done",
            "cancelled",
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "importSource",
        "sourceSystem",
        "name",
        "dryRun",
        "status",
        "startedAt",
        "finishedAt",
        "batches"
      ],
      "type": "object"
    },
    "sampleSummary": {
      "additionalProperties": false,
      "properties": {
        "compared": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "matched": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mismatched": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "compared",
        "matched",
        "mismatched"
      ],
      "type": "object"
    },
    "samples": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "user",
              "group",
              "team",
              "role",
              "status",
              "priority",
              "close_reason",
              "ticket_type",
              "link_type",
              "track",
              "release",
              "area",
              "field",
              "field_context",
              "field_option",
              "field_rule_set",
              "layout_set",
              "workflow",
              "workflow_map",
              "ticket",
              "comment",
              "link",
              "time_entry",
              "attachment",
              "history"
            ],
            "type": "string"
          },
          "match": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "sourceChecksum": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "targetChecksum": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "targetId": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "sourceId",
          "targetId",
          "sourceChecksum",
          "targetChecksum",
          "match"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "totals": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "fidelity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "target",
        "failed",
        "fidelity"
      ],
      "type": "object"
    },
    "unsupported": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "count",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": 1,
      "type": "number"
    },
    "warnings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "count": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "examples": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "code",
          "detail",
          "count",
          "examples"
        ],
        "type": "object"
      },
      "type": "array"
    }
